PORT=3000

# OpenAI (required unless DRY_RUN=1)
OPENAI_API_KEY=

# Email — Gmail SMTP (required unless DRY_RUN=1)
# EMAIL_FROM: your Gmail address
# EMAIL_PASS: Gmail App Password (not your login password)
#   Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
# EMAIL_TO: where lead alerts go (defaults to EMAIL_FROM if not set)
EMAIL_FROM=you@gmail.com
EMAIL_PASS=
EMAIL_TO=

# Public Calendly scheduling link (overrides business.json if set)
CALENDLY_URL=https://calendly.com/your-link/consult

# Optional: require Authorization: Bearer <secret> on POST /webhook/formspree
WEBHOOK_SECRET=

# Set to 1 to log AI output without sending email (safe local testing)
DRY_RUN=0

# Meta Conversions API — GHL stage-change → Meta CAPI event
META_DATASET_ID=1337201488230179
META_CAPI_TOKEN=
